# Copy to .env. Backend only. Never commit real values.

# Downloaded third-party data, kept outside the repo. See data/DOWNLOADS.md.
DATA_DIR=../DATA

# Gnani speech (Prisma, Timbre)
GNANI_API_KEY=

# LLM for extraction and report writing: Gemini first, then Groq, then a local Ollama model.
# Gemini keys also render test audio. Ollama takes no key.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# Supabase. The anon key is the publishable key (sb_publishable_...), the service-role key the secret one (sb_secret_...).
# SUPABASE_DB_URL is the session-pooler connection string, password URL-encoded, for creating tables and bulk uploads.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Doctor workspace (services/api/voicerx/app). APP_DEV_LOGIN=1 lists synthetic doctors to sign in as, with no
# password; leave it off anywhere real people or data could reach the server.
APP_DEV_LOGIN=
APP_LLM_PROVIDER=groq
APP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Optional Meta test-number transport. Leave blank for the integrated local simulator.
# Callback: /whatsapp/webhook. Use a one-use invitation from an approved dashboard visit.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEST_NUMBERS=
# Public business sender number, including country code, for the patient's one-time JOIN link.
WHATSAPP_SENDER_NUMBER=
# Optional synthetic clinic demo: send every approval in this organisation to this allowed test number.
# This is a clinic copy, not a verified patient-phone link. Audio is sent only after its report button is tapped.
WHATSAPP_CLINIC_REPORT_ORG=
WHATSAPP_CLINIC_REPORT_NUMBER=
PATIENT_HASH_KEY=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
