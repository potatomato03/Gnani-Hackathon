# Copy to .env. Backend only. Never commit real values.

# Downloaded third-party data, kept outside the repo. See data/DOWNLOADS.md.
DATA_DIR=../DATA

# Gnani speech (Prisma, Timbre)
GNANI_API_KEY=

# Real WhatsApp, private testing only (docs/whatsapp-testing.md, runbook D-113). All five or WhatsApp stays off.
# From the Meta app: WhatsApp > API Setup (token, phone number ID), App settings > Basic (app secret).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any long random string you choose; paste the same one into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Your own phone(s): digits only, with country code, comma-separated. Every other number is ignored.
WHATSAPP_TEST_NUMBERS=

# LLM for extraction and report writing: Gemini first, then Groq, then a local Ollama model.
# Gemini keys also render test audio. Ollama takes no key.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# Supabase. The anon key is the publishable key (sb_publishable_...), the service-role key the secret one (sb_secret_...).
# SUPABASE_DB_URL is the session-pooler connection string, password URL-encoded, for creating tables and bulk uploads.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
