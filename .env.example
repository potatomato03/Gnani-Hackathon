# Copy to .env. Backend only. Never commit real values.

# Gnani speech (Prisma, Timbre)
GNANI_API_KEY=

# LLM. Start on a free provider, move to Anthropic only if tests show the need.
LLM_PROVIDER=gemini
EXTRACTION_MODEL=gemini-3.8-flash
PLANNER_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
