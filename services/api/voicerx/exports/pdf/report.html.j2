{% set footer %}Version {{ report.version }} · {{ report.content_hash[:12] }}{% if report.status == 'approved' %} · Approved by {{ report.approved_by }} · {{ report.approved_at|ist }}{% else %} · DRAFT, NOT APPROVED{% endif %}{% endset %}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>VoiceRX - {{ report.case_id }}</title>
<style>
@page { size: A4; margin: 15mm 13mm 22mm; @bottom-left { content: {{ footer|striptags|css_string }}; font: 7.5pt sans-serif; color: #596970; width: 80%; } @bottom-right { content: "Page " counter(page) " of " counter(pages); font: 8pt sans-serif; color: #5d6873; } }
* { box-sizing: border-box; }
body { font-family: "Noto Sans", "Noto Sans Devanagari", "Noto Sans Telugu", "Noto Sans Tamil", "Nirmala UI", sans-serif; font-size: 10pt; line-height: 1.45; color: #172b35; margin: 0; }
.banner { font-size: 9pt; font-weight: 700; letter-spacing: 0; color: #805300; border-bottom: 2px solid #d3a94a; padding-bottom: 7px; }
h1 { font-size: 21pt; font-weight: 650; margin: 12px 0 3px; color: #134d53; }
.subtitle { color: #5d6873; margin-bottom: 14px; }
.identity { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
.identity td { padding: 2px 12px 2px 0; vertical-align: top; width: 50%; }
.allergies { background: #f2f5f5; border-left: 3px solid #537b7e; padding: 7px 10px; margin: 8px 0 15px; }
h2 { font-size: 11pt; color: #134d53; margin: 13px 0 4px; break-after: avoid; }
p { margin: 3px 0; }
section { break-inside: avoid; }
.opening { margin: 4px 0 2px; }
section p { text-align: justify; }
p.advice { margin: 3px 0 6px; }
p.review { font-weight: 700; margin-top: 14px; }
.medicines { width: 100%; border-collapse: collapse; margin: 6px 0 12px; font-size: 9pt; table-layout: fixed; }
.medicines th { color: white; background: #215e64; padding: 7px 4px; text-align: center; }
.medicines th:first-child { width: 60%; text-align: left; }
.medicines td { border-bottom: 1px solid #cbd7d8; padding: 8px 5px; vertical-align: top; overflow-wrap: anywhere; }
.medicines td:not(:first-child) { text-align: center; }
.medicines tr { break-inside: avoid; }
.detail { font-size: 9pt; font-weight: normal; color: #45565e; margin-top: 5px; }
.flag { color: #9b3526; font-size: 9pt; }
.box { background: #f1f6f4; border: 1px solid #b7cfca; padding: 10px 12px; break-inside: avoid; margin-top: 14px; }
.box h2 { margin-top: 0; }
.note { font-size: 8.5pt; color: #596970; margin-top: 8px; }
.issues { margin-top: 15px; border-top: 1px solid #ddd; padding-top: 5px; break-inside: avoid; }
.issues p { font-size: 8.5pt; }
.footer { display: none; }
.watermark { position: fixed; top: 42%; left: 0; width: 100%; text-align: center; font-size: 35pt; font-weight: 700; color: rgba(145,65,30,.13); transform: rotate(-25deg); pointer-events: none; z-index: -1; }
</style></head><body>
{% if report.status == 'draft' %}<div class="watermark">DRAFT, NOT APPROVED</div>{% endif %}
<div class="footer">{{ footer }}</div>
<div class="banner">SYNTHETIC DATA</div>
<h1>Outpatient summary</h1><div class="subtitle">{{ report.header.clinic_name }}</div>
<table class="identity"><tr><td><b>{{ report.header.patient_name }}</b><br>{{ report.header.age }} years (approx.) · {{ report.header.sex }}<br>{{ report.header.patient_id }} · {{ report.header.mrn }}</td><td><b>{{ report.header.doctor_name }}</b><br>Registration: {{ report.header.doctor_reg_no }}<br>Visit: {{ report.header.visit_date.strftime('%d-%b-%Y') }}</td></tr></table>
<div class="allergies">{{ report.header.allergy_text }}</div>
<p class="opening">Patient seen in the outpatient clinic on {{ report.header.visit_date.strftime('%d-%b-%Y') }}.</p>
{% for title, sections in groups %}{% set ns = namespace(lines=[]) %}{% for s in sections %}{% set ns.lines = ns.lines + report.sections.get(s, []) %}{% endfor %}
{% if title == 'Review' %}{% for line in ns.lines %}<p class="review">{{ line.text|sentence }}</p>{% endfor %}
{% elif ns.lines %}<section><h2>{{ title }}</h2>{% if title == 'Treatment advised' %}{% for line in ns.lines %}<p class="advice">{{ line.text|sentence }}</p>{% endfor %}{% else %}<p>{{ ns.lines|map(attribute='text')|map('sentence')|join(' ') }}</p>{% endif %}</section>{% endif %}
{% if title == 'Present problem' and report.current_medicines %}<section><h2>Current medicines</h2>{% for line in report.current_medicines %}<p>{{ line }}</p>{% endfor %}</section>{% endif %}
{% if title == 'Treatment advised' and report.medicines %}<h2>Prescription</h2><table class="medicines"><thead><tr><th>Medicine</th><th>Morning</th><th>Afternoon</th><th>Evening</th><th>Night</th></tr></thead><tbody>
{% for row in report.medicines %}<tr><td><b>{{ row.label }}</b><div class="detail">{{ row.detail }}</div>{% if row.flags %}<div class="flag">{{ row.flags|join(', ') }}</div>{% endif %}</td>{% for slot in row.grid %}<td>{{ slot }}</td>{% endfor %}</tr>{% endfor %}
</tbody></table>{% endif %}
{% endfor %}
{% if box %}<div class="box" lang="{{ box.language }}"><h2>{{ box.title }}</h2>{% for row in box.rows %}<p>{{ row }}</p>{% endfor %}<p class="note">{{ box.official_note }}</p>{% if box.note %}<p class="note">{{ box.note }}</p>{% endif %}</div>{% endif %}
{% if report.issues %}<div class="issues"><h2>Review required</h2>{% for issue in report.issues %}<p class="{% if issue.severity == 'block' %}flag{% endif %}">{{ issue.severity|upper }} · {{ issue.target }} · {{ issue.message }}</p>{% endfor %}</div>{% endif %}
<p class="note">Prototype: formulary entries and allergy class rules have not been clinically reviewed.</p>
</body></html>
